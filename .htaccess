# Blokir akses file rahasia
<FilesMatch "^\.env$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

<FilesMatch "\.(env|log|bak|old|sql|ini|conf)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>
